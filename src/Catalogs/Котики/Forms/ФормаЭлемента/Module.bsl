
&НаКлиенте
Процедура Загрузить(Команда)               
	// Извлекаем Файл из пути
	Файл = Новый Файл(Объект.ПутьКФайлу);
	
	// Проверяем что он действительно существует
	Если Файл.Существует() Тогда
		// Преобразуем его по пути в двоичные данные
		ДД = Новый ДвоичныеДанные(Объект.ПутьКФайлу); 
		// И загружаем на сервер преобразованные двоичные данные
		ЗагрузитьНаСервере(ДД);
		
		ЭтаФорма.Модифицированность = Ложь;
		ОбновитьКартинку();
		Объект.ФотоВывод = "Да";
	Иначе
		Сообщить("Выберите файл картинки");
	КонецЕсли
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНаСервере(ДД)
	Хранилище = Новый ХранилищеЗначения(ДД);
	// Преобразуем реквизит формы в объект
	Об = РеквизитФормыВЗначение("Объект");
	
	// Передаем изображение из хранилища в реквизит "Картинка"
	Об.Фотография = Хранилище;
	
	// Записываем изображение
	Об.Записать();
	
	//И преобразуем его в реквизит.
	ЗначениеВРеквизитФормы(Об,"Объект");
КонецПроцедуры

&НаСервере
Процедура ОбновитьКартинку()
	Картинка = ПоместитьВоВременноеХранилище
		(Объект.Ссылка.Фотография.Получить(),
		УникальныйИдентификатор);	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если Объект.ФотоВывод = "Да" Тогда
		ОбновитьКартинку();
	Иначе
		//Если изображение не загружалось еще, то вместо картинки загружаем во временное хранилище заглушку
		Картинка = ПоместитьВоВременноеХранилище(БиблиотекаКартинок.ЗаглушкаКотик, УникальныйИдентификатор);
	КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Заголовок = "Выберите картинку для загрузки";
	Диалог.Фильтр = "Файл JPG, PNG, JPEG |*.jpg; *.png; *.jpeg";
	Если Диалог.Выбрать() Тогда
		Объект.ПутьКФайлу = Диалог.ПолноеИмяФайла;
	КонецЕсли;
КонецПроцедуры

